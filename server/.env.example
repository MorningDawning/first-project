# Postgres. Локально: `docker compose up -d` (см. docker-compose.yml) или строка подключения из облака.
DATABASE_URL="postgresql://beervia:beervia@localhost:5432/beervia"
# На боевом сервере обязательно длинная случайная строка (от 24 символов).
JWT_SECRET="beervia-dev-secret-change-in-prod"
PORT=4000
# Папка для загруженных фото и голосовых. На хостинге — путь постоянного диска (например /data/uploads).
# UPLOADS_DIR="/data/uploads"
# Сервис распознавания этикеток (см. /ml). Не задан — /scan работает в резервном режиме.
ML_SERVICE_URL="http://localhost:8001"
