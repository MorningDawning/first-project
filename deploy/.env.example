# Скопируйте в .env и заполните.

# Адрес сервера. Своего домена нет — используйте бесплатное имя на основе IP-адреса сервера:
# для IP 185.12.34.56 это 185-12-34-56.sslip.io (точки в IP заменены дефисами).
DOMAIN=185-12-34-56.sslip.io

# Пароль базы и секрет входа: длинные случайные строки. Получить: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Для политики конфиденциальности: кто оператор данных и куда писать пользователям
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
